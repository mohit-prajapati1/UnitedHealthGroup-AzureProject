{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['employees'][0]['employee_id']"
								},
								"sink": {
									"name": "employee_id",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['employees'][0]['employee_name']"
								},
								"sink": {
									"name": "employee_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['employees'][0]['department']"
								},
								"sink": {
									"name": "department",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['employees'][0]['salary']"
								},
								"sink": {
									"name": "salary",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "$['employees'][0]['joining_date']"
								},
								"sink": {
									"name": "joining_date",
									"type": "Date"
								}
							}
						],
						"collectionReference": "$['employees']"
					}
				},
				"inputs": [
					{
						"referenceName": "Json1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}